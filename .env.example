# MyPAL — configuracion local (NO se sube a git)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/mypal
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@localhost:5432/mypal_test

APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Tavus
TAVUS_API_KEY=
TAVUS_BASE_PAL_ID=p3a4e97dc806
# Cara del avatar para niños (ardilla "Nuez", cara de sistema Dr. Paws)
TAVUS_KIDS_FACE_ID=r21a52c53fa4
# Solo para "pnpm tavus:setup --verify" (conversaciones de prueba sin costo).
TAVUS_TEST_MODE=true
# fake = simulador local, SIN costo (por defecto). http = Tavus real: cada clase gasta minutos.
TAVUS_DRIVER=fake
TAVUS_WEBHOOK_SECRET=
# URL publica para webhooks (vacia en local: se usa polling)
PUBLIC_WEBHOOK_URL=
# Voces TTS por tutor (vacias = voz propia del avatar). Sarah (EE. UU.) y Alice (Reino Unido), ElevenLabs via Tavus.
# Aleman: la voz propia de Poly (Ruby). Ninos: la voz propia de la ardilla.
TAVUS_TTS_ENGINE=elevenlabs
TAVUS_VOICE_EN_US=EXAVITQu4vr4xnSDxMaL
TAVUS_VOICE_EN_GB=Xb7hH8MSUJpSbSDYk0k2
TAVUS_VOICE_DE=

# ElevenLabs 
ELEVENLABS_API_KEY=

# Voces ElevenLabs (formato id:nombre separados por coma)
# Test de nivel (2 por variante)
ELEVENLABS_VOICES_EN_US=EXAVITQu4vr4xnSDxMaL:Sarah,cjVigY5qzO86Huf0OWal:Eric
ELEVENLABS_VOICES_EN_GB=Xb7hH8MSUJpSbSDYk0k2:Alice,JBFqnCBsd6RMkjVDRZzb:George
ELEVENLABS_VOICES_DE=VD1if7jDVYtAKs4P0FIY:Milly,K5ZVtkkBnuPY6YqXs70E:Simon
# Examenes: IELTS usa acentos variados; aleman, voces nativas
ELEVENLABS_EXAM_VOICES_EN=Xb7hH8MSUJpSbSDYk0k2:Alice-UK-F,JBFqnCBsd6RMkjVDRZzb:George-UK-M,EXAVITQu4vr4xnSDxMaL:Sarah-US-F,cjVigY5qzO86Huf0OWal:Eric-US-M,IKne3meq5aSn9XLyUdCD:Charlie-AU-M,pFZP5JQG7iQjIQuC4Bku:Lily-UK-F,onwK4e9ZLuTAKqWW03F9:Daniel-UK-M,XrExE9yKIg1WjnnlVkGX:Matilda-US-F
ELEVENLABS_EXAM_VOICES_DE=VD1if7jDVYtAKs4P0FIY:Milly-F,K5ZVtkkBnuPY6YqXs70E:Simon-M,BIvP0GN1cAtSRTxNHnWS:Ellen-F
# Voz del examinador por defecto
ELEVENLABS_EXAMINER_EN=JBFqnCBsd6RMkjVDRZzb
# Modelo de Text to Dialogue (audios de Listening). Vacio = el de ElevenLabs por defecto.
ELEVENLABS_DIALOGUE_MODEL=eleven_v3
# fake = silencio, sin llamar a ElevenLabs (tests)
# Modelo de voz del examinador de Speaking (vacio = el del cliente; uno rapido baja la espera)
ELEVENLABS_EXAMINER_MODEL=eleven_flash_v2_5
ELEVENLABS_DRIVER=
ELEVENLABS_EXAMINER_DE=K5ZVtkkBnuPY6YqXs70E


# Cloudflare Turnstile (claves de PRUEBA de Cloudflare: siempre pasan)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Pagos: fake = checkout simulado
PAYMENT_DRIVER=fake

# Hash de IP/dispositivo para antiabuso
HASH_PEPPER=

# Google Gemini (generacion y calificacion de examenes)
GEMINI_API_KEY=
# gemini = API real | fake = simulador sin costo (tests)
AI_DRIVER=gemini
# Modelos por defecto (se pueden cambiar en /admin/configuracion sin desplegar)
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FLASH=gemini-3.8-flash

# Amazon S3 (audios del banco de examenes, grabaciones). Usuario IAM con permisos solo sobre el bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PREFIX=mypal
# Dias que se guardan las grabaciones de Speaking
S3_RECORDINGS_RETENTION_DAYS=180
