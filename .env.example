# MyPAL — configuracion local (NO se sube a git)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/mypal
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@localhost:5432/mypal_test

APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Tavus
TAVUS_API_KEY=
TAVUS_BASE_PAL_ID=p3a4e97dc806
# Cara del avatar para niños (ardilla "Nuez", cara de sistema Dr. Paws)
TAVUS_KIDS_FACE_ID=r21a52c53fa4
# Solo para "pnpm tavus:setup --verify" (conversaciones de prueba sin costo).
TAVUS_TEST_MODE=true
# fake = simulador local, SIN costo (por defecto). http = Tavus real: cada clase gasta minutos.
TAVUS_DRIVER=fake
TAVUS_WEBHOOK_SECRET=
# URL publica para webhooks (vacia en local: se usa polling)
PUBLIC_WEBHOOK_URL=
# Voces TTS por tutor (vacias = voz propia del avatar). Sarah (EE. UU.) y Alice (Reino Unido), ElevenLabs via Tavus.
# Aleman: la voz propia de Poly (Ruby). Ninos: la voz propia de la ardilla.
TAVUS_TTS_ENGINE=elevenlabs
TAVUS_VOICE_EN_US=EXAVITQu4vr4xnSDxMaL
TAVUS_VOICE_EN_GB=Xb7hH8MSUJpSbSDYk0k2
TAVUS_VOICE_DE=

# ElevenLabs 
ELEVENLABS_API_KEY=

# Cloudflare Turnstile (claves de PRUEBA de Cloudflare: siempre pasan)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Pagos: fake = checkout simulado
PAYMENT_DRIVER=fake

# Hash de IP/dispositivo para antiabuso
HASH_PEPPER=

# Google Gemini (generacion y calificacion de examenes)
GEMINI_API_KEY=
# gemini = API real | fake = simulador sin costo (tests)
AI_DRIVER=gemini

# Amazon S3 (audios del banco de examenes, grabaciones). Usuario IAM con permisos solo sobre el bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PREFIX=mypal
