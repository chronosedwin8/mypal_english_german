// MyPAL — modelo de datos
//
// Reglas de dinero (minutos):
//  - Todo se mide en SEGUNDOS enteros y centavos de USD enteros. Sin floats en el ledger.
//  - LedgerEntry es de solo-insercion. Los saldos viven en MinuteWallet / MinuteBucket y
//    la base de datos los protege con CHECKs (ver migracion "money_guards").
//  - Orden de candados: MinuteWallet(user) -> TutorSession -> MinuteBucket (por id) -> ConcurrencySlot.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

/// Variante que se aprende (cada una tiene su propio tutor en Tavus).
enum TargetLang {
  EN_US
  EN_GB
  DE
}

/// Publico: adultos (Poly) o niños (Nuez, la ardilla). Cada uno tiene sus propios tutores.
enum Audience {
  ADULT
  KIDS
}

/// Idioma base para contenido compartido (EN_US y EN_GB comparten banco de preguntas).
enum BaseLang {
  EN
  DE
}

enum Cefr {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum BucketSource {
  TRIAL
  PLAN_CYCLE
  ADMIN_GRANT
  TOPUP
}

enum LedgerType {
  GRANT
  HOLD
  CAPTURE
  RELEASE
  EXPIRE
  CLAWBACK
  ADJUST
}

enum SessionStatus {
  RESERVED
  CREATING
  READY
  LIVE
  ENDING
  ENDED
  SETTLED
  FAILED
}

enum EndReason {
  USER_END
  TAB_CLOSE
  CLIENT_LEFT
  TAVUS_SHUTDOWN
  DEADLINE
  NO_SHOW
  HEARTBEAT_LOST
  ADMIN
  CREATE_FAILED
  ORPHAN
}

enum SlotState {
  FREE
  OFFERED
  BUSY
  DISABLED
}

enum QueueStatus {
  WAITING
  OFFERED
  CLAIMED
  EXPIRED
  CANCELLED
  ABANDONED
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentKind {
  SUBSCRIPTION
  TOPUP
}

enum PaymentStatus {
  SUCCEEDED
  REFUNDED
  FAILED
}

enum Skill {
  GRAMMAR
  VOCAB
  READING
  LISTENING
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// ============================================================================
// Autenticacion (tablas de Better Auth)
// ============================================================================

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  /// STUDENT | ADMIN (string para que Better Auth lo escriba sin enums)
  /// STUDENT | SUPPORT (solo lectura del admin) | ADMIN
  role             String    @default("STUDENT")
  /// segundo factor (TOTP) activo; obligatorio para administradores en produccion
  twoFactorEnabled Boolean?  @default(false)
  /// minusculas y, en gmail, sin puntos ni +etiqueta: evita pruebas gratis repetidas
  emailCanonical   String?
  bannedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  profiles           LanguageProfile[]
  wallet             MinuteWallet?
  buckets            MinuteBucket[]
  subscriptions      Subscription[]
  payments           Payment[]
  tutorSessions      TutorSession[]
  queueEntries       SessionQueueEntry[]
  vocabulary         VocabularyItem[]
  diagnosticAttempts DiagnosticAttempt[]
  trialClaim         TrialClaim?
  lessonProgress     LessonProgress[]
  corrections        SessionCorrection[]
  examAttempts       ExamAttempt[]
  studyPlans         StudyPlan[]
  examEntitlements   ExamEntitlement[]
  orgMembers         OrgMember[]
  twoFactors         TwoFactor[]

  @@index([emailCanonical])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ============================================================================
// Perfil de aprendizaje
// ============================================================================

model LanguageProfile {
  id             String     @id @default(uuid(7))
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  language       TargetLang
  level          Cefr?
  /// DIAGNOSTIC | SELF | TUTOR | ADMIN
  levelSource    String?
  theta          Float?
  skillScores    Json?
  /// Valor de participant_tags en Tavus (memoria del tutor entre clases)
  memoryTag      String     @unique
  xp             Int        @default(0)
  streakDays     Int        @default(0)
  lastPracticeAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, language])
}

// ============================================================================
// Comercio
// ============================================================================

model Plan {
  /// codigo estable: basico | fluido | inmersion
  id                   String         @id
  nameEs               String
  priceUsdCents        Int
  monthlySeconds       Int
  perSessionCapSeconds Int
  isActive             Boolean        @default(true)
  highlight            Boolean        @default(false)
  sortOrder            Int
  features             Json
  /// TUTOR | EXAM | EXAM_ADDON
  kind                 String         @default("TUTOR")
  /// cupos de examen por ciclo: { MOCK, WRITING, SPEAKING }
  examQuotas           Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  subscriptions        Subscription[]
}

model TopupPack {
  /// codigo estable: recarga-15 | recarga-30
  id            String   @id
  nameEs        String
  priceUsdCents Int
  seconds       Int
  validityDays  Int      @default(90)
  isActive      Boolean  @default(true)
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id                 String    @id @default(uuid(7))
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  /// fake | stripe | mercadopago | wompi
  provider           String
  externalId         String
  /// TUTOR (minutos con avatar) | EXAM (plan o pase de examen): uno vivo de cada tipo
  kind               String    @default("TUTOR")
  status             SubStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([provider, externalId])
  @@unique([userId, kind], map: "one_live_subscription_per_kind", where: raw("status = ANY (ARRAY['ACTIVE'::\"SubStatus\", 'PAST_DUE'::\"SubStatus\"])"))
  @@index([userId, status])
}

model Payment {
  id               String        @id @default(uuid(7))
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  externalId       String
  kind             PaymentKind
  status           PaymentStatus
  subscriptionId   String?
  planId           String?
  topupPackId      String?
  amountUsdCents   Int
  feeUsdCents      Int           @default(0)
  netUsdCents      Int
  refundedUsdCents Int           @default(0)
  secondsGranted   Int           @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime      @default(now())

  @@unique([provider, externalId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ProcessedWebhookEvent {
  provider   String
  eventId    String
  type       String
  receivedAt DateTime @default(now())

  @@id([provider, eventId])
}

// ============================================================================
// Minutos (ledger)
// ============================================================================

/// Una fila por usuario. Es el candado (FOR UPDATE) de toda operacion de minutos.
model MinuteWallet {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableSeconds Int      @default(0)
  heldSeconds      Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model MinuteBucket {
  id              String        @id @default(uuid(7))
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          BucketSource
  /// PLAN_CYCLE=10, ADMIN_GRANT=15, TOPUP=20 (TRIAL aislado)
  priority        Int
  grantedSeconds  Int
  heldSeconds     Int           @default(0)
  consumedSeconds Int           @default(0)
  expiredSeconds  Int           @default(0)
  validFrom       DateTime      @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  /// "plan:<pagoId>" | "topup:<pagoId>" | "trial:<userId>" | "admin:<auditId>"
  grantKey        String        @unique
  paymentId       String?       @unique
  subscriptionId  String?
  createdAt       DateTime      @default(now())
  holds           SessionHold[]

  @@unique([userId], map: "one_trial_bucket_per_user", where: raw("source = 'TRIAL'"))
  @@index([userId, expiresAt])
}

/// Solo insercion. Nunca UPDATE/DELETE.
model LedgerEntry {
  id             BigInt     @id @default(autoincrement())
  userId         String
  bucketId       String
  sessionId      String?
  type           LedgerType
  /// magnitud > 0
  seconds        Int
  deltaAvailable Int
  deltaHeld      Int
  idempotencyKey String     @unique
  reason         String?
  actorUserId    String?
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
}

/// Que cubo financia cada clase y cuanto se cobro/libero de el.
model SessionHold {
  sessionId       String
  session         TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bucketId        String
  bucket          MinuteBucket @relation(fields: [bucketId], references: [id])
  allocOrder      Int
  heldSeconds     Int
  capturedSeconds Int          @default(0)
  releasedSeconds Int          @default(0)

  @@id([sessionId, bucketId])
}

// ============================================================================
// Clases con el tutor
// ============================================================================

model TutorSession {
  id                  String              @id @default(uuid(7))
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  language            TargetLang
  audience            Audience            @default(ADULT)
  lessonId            String?
  isTrial             Boolean             @default(false)
  testMode            Boolean             @default(false)
  status              SessionStatus       @default(RESERVED)
  /// Idempotency-Key del cliente (evita doble clic)
  clientRequestId     String
  queueEntryId        String?             @unique
  slotId              Int?
  palId               String
  /// "mypal:<id>" para encontrar conversaciones huerfanas
  conversationName    String              @unique
  tavusConversationId String?             @unique
  conversationUrl     String?
  meetingToken        String?
  reservedSeconds     Int
  maxCallDurationSec  Int
  createRequestedAt   DateTime?
  tavusCreatedAt      DateTime?
  hardDeadlineAt      DateTime?
  joinedAt            DateTime?
  lastHeartbeatAt     DateTime?
  cancelRequested     Boolean             @default(false)
  endRequestedAt      DateTime?
  endReason           EndReason?
  tavusEndedAt        DateTime?
  endObservedAt       DateTime?
  shutdownReason      String?
  /// Equivalente Tavus (redondeo a 6 s, minimo 30 s)
  billedSeconds       Int?
  /// Descontado al usuario (0 si se perdona)
  chargedSeconds      Int?
  uncollectedSeconds  Int                 @default(0)
  /// Costo por minuto en micro-USD al iniciar (snapshot)
  costPerMinMicroUsd  Int
  costMicroUsd        BigInt?
  failureCode         String?
  settledAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  holds               SessionHold[]
  transcript          Transcript?
  corrections         SessionCorrection[]

  @@unique([userId, clientRequestId])
  @@unique([userId], map: "one_open_session_per_user", where: raw("status = ANY (ARRAY['RESERVED'::\"SessionStatus\", 'CREATING'::\"SessionStatus\", 'READY'::\"SessionStatus\", 'LIVE'::\"SessionStatus\", 'ENDING'::\"SessionStatus\"])"))
  @@unique([userId], map: "one_trial_session_per_user", where: raw("\"isTrial\" AND status <> 'FAILED'"))
  @@index([status, hardDeadlineAt])
  @@index([userId, createdAt(sort: Desc)])
}

/// N filas = limite de concurrencia del plan Tavus.
model ConcurrencySlot {
  id           Int       @id
  state        SlotState @default(FREE)
  sessionId    String?   @unique
  queueEntryId String?   @unique
  offeredUntil DateTime?
  changedAt    DateTime  @updatedAt
}

model SessionQueueEntry {
  id         String      @id @default(uuid(7))
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  language   TargetLang
  lessonId   String?
  status     QueueStatus @default(WAITING)
  lastSeenAt DateTime    @default(now())
  offeredAt  DateTime?
  createdAt  DateTime    @default(now())

  @@unique([userId], map: "one_active_queue_entry", where: raw("status = ANY (ARRAY['WAITING'::\"QueueStatus\", 'OFFERED'::\"QueueStatus\"])"))
  @@index([status, createdAt])
}

model TavusEvent {
  id             BigInt    @id @default(autoincrement())
  sessionId      String?
  conversationId String
  eventType      String
  eventTs        DateTime?
  payload        Json
  /// WEBHOOK | POLL | CLIENT
  source         String
  dedupeKey      String    @unique
  receivedAt     DateTime  @default(now())

  @@index([sessionId])
}

model Transcript {
  sessionId          String       @id
  session            TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turns              Json
  perceptionAnalysis String?
  summaryEs          String?
  fetchedVia         String
  createdAt          DateTime     @default(now())
}

model SessionCorrection {
  id          String       @id @default(uuid(7))
  sessionId   String
  session     TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  original    String
  corrected   String
  explanation String?
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
}

// ============================================================================
// Aprendizaje
// ============================================================================

model VocabularyItem {
  id             String     @id @default(uuid(7))
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  language       TargetLang
  term           String
  termNormalized String
  translationEs  String?
  example        String?
  /// TOOL_CALL | LESSON | MANUAL
  source         String
  sessionId      String?
  ease           Float      @default(2.5)
  intervalDays   Int        @default(0)
  reps           Int        @default(0)
  lapses         Int        @default(0)
  dueAt          DateTime   @default(now())
  createdAt      DateTime   @default(now())

  @@unique([userId, language, termNormalized])
  @@index([userId, language, dueAt])
}

model DiagnosticItem {
  /// codigo estable, p. ej. "en-b1-grammar-03"
  id            String               @id
  lang          BaseLang
  skill         Skill
  level         Cefr
  /// dificultad IRT (logits)
  difficulty    Float
  stem          String
  passage       String?
  /// texto que se convierte en audio (items de escucha)
  audioText     String?
  options       Json
  /// nunca se envia al navegador
  correctIndex  Int
  explanationEs String?
  isActive      Boolean              @default(true)
  timesServed   Int                  @default(0)
  timesCorrect  Int                  @default(0)
  responses     DiagnosticResponse[]

  @@index([lang, isActive, difficulty])
}

model DiagnosticAttempt {
  id            String               @id @default(uuid(7))
  userId        String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// cookie anonima: el test se hace sin registro y se liga al crear la cuenta
  anonId        String?
  language      TargetLang
  status        AttemptStatus        @default(IN_PROGRESS)
  theta         Float                @default(-1.0)
  thetaSe       Float                @default(1.0)
  resultLevel   Cefr?
  skillScores   Json?
  /// ITEMS -> SPEAKING -> DONE
  phase         String               @default("ITEMS")
  /// pregunta servida y aun sin responder (evita responder preguntas arbitrarias)
  currentItemId String?
  speakingScore Float?
  speakingCount Int                  @default(0)
  ipPrefixHash  String?
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  responses     DiagnosticResponse[]
  speaking      SpeakingSample[]

  @@index([userId])
  @@index([anonId])
  @@index([ipPrefixHash, startedAt])
}

model DiagnosticResponse {
  attemptId   String
  attempt     DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  itemId      String
  item        DiagnosticItem    @relation(fields: [itemId], references: [id])
  seq         Int
  chosenIndex Int
  isCorrect   Boolean
  thetaAfter  Float
  seAfter     Float
  latencyMs   Int?
  answeredAt  DateTime          @default(now())

  @@id([attemptId, itemId])
  @@unique([attemptId, seq])
}

model SpeakingSample {
  id             String            @id @default(uuid(7))
  attemptId      String
  attempt        DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskId         String
  transcript     String
  /// 0..1 precision frente a la frase de referencia (lectura en voz alta)
  accuracy       Float?
  wordsPerMinute Float?
  uniqueWords    Int?
  durationMs     Int
  /// 0..1
  score          Float
  createdAt      DateTime          @default(now())

  @@unique([attemptId, taskId])
}

model Module {
  id            String   @id
  lang          BaseLang
  audience      Audience @default(ADULT)
  level         Cefr
  slug          String
  titleEs       String
  descriptionEs String
  emoji         String?
  sortOrder     Int
  isPublished   Boolean  @default(true)
  lessons       Lesson[]

  @@unique([lang, slug])
}

model Lesson {
  id               String           @id
  moduleId         String
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug             String
  titleEs          String
  objectives       String[]
  targetVocab      String[]
  /// instrucciones (en ingles) que recibe el tutor en conversational_context
  tutorBrief       String
  usesVision       Boolean          @default(false)
  suggestedMinutes Int
  sortOrder        Int
  progress         LessonProgress[]

  @@unique([moduleId, slug])
}

model LessonProgress {
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sessionsCount Int       @default(0)
  lastSessionAt DateTime?
  completedAt   DateTime?

  @@id([userId, lessonId])
}

// ============================================================================
// Antiabuso, Tavus, configuracion
// ============================================================================

model TrialClaim {
  id             String   @id @default(uuid(7))
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailCanonical String   @unique
  deviceIdHash   String   @unique
  /// /24 IPv4 o /64 IPv6, con pepper
  ipPrefixHash   String
  sessionId      String?  @unique
  createdAt      DateTime @default(now())

  @@index([ipPrefixHash, createdAt])
}

model TavusPal {
  variant        TargetLang
  audience       Audience   @default(ADULT)
  palId          String     @unique
  faceId         String
  basePalId      String
  palName        String
  specHash       String
  lastSyncedAt   DateTime
  lastVerifiedAt DateTime?

  @@id([variant, audience])
}

model AppConfig {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================================
// Examenes (IELTS Academic, Goethe B1/B2/C1, TestDaF) — ver docs/PLAN-EXAMENES.md
// ============================================================================

enum ExamCode {
  IELTS_ACADEMIC
  GOETHE_B1
  GOETHE_B2
  GOETHE_C1
  TESTDAF
}

/// Hören, Lesen, Schreiben y Sprechen usan los mismos valores.
enum ExamSection {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum ItemSetStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  RETIRED
}

enum ExamMode {
  DRILL
  PART
  SECTION
  WRITING
  SPEAKING
  REVIEW
  ENTRY
  MOCK
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SCORING
  COMPLETED
  ABANDONED
  VOIDED
}

enum ExamJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ExamQuotaKind {
  MOCK
  WRITING
  SPEAKING
}

/// Bloque del banco: un texto o grabacion con sus preguntas, como en el examen real.
model ExamItemSet {
  id            String         @id @default(uuid(7))
  exam          ExamCode
  section       ExamSection
  part          Int
  taskTypes     String[]
  /// dificultad en la escala del examen (banda IELTS o nivel numerico)
  difficulty    Float
  topic         String
  /// contenido publico (texto, preguntas, opciones). Nunca incluye la clave.
  content       Json
  /// clave de respuestas y justificacion. NUNCA sale al navegador.
  answerKey     Json
  status        ItemSetStatus  @default(DRAFT)
  promptVersion String
  model         String
  qualityScore  Float?
  reviewNote    String?
  costMicroUsd  BigInt         @default(0)
  timesServed   Int            @default(0)
  timesCorrect  Int            @default(0)
  createdAt     DateTime       @default(now())
  approvedAt    DateTime?
  audio         AudioAsset[]
  exposures     ItemExposure[]

  @@index([exam, section, part, status, difficulty])
  @@index([status, createdAt])
}

model AudioAsset {
  id              String      @id @default(uuid(7))
  itemSetId       String
  itemSet         ExamItemSet @relation(fields: [itemSetId], references: [id], onDelete: Cascade)
  storageKey      String      @unique
  durationMs      Int
  voices          Json
  script          Json
  /// similitud 0..1 entre la transcripcion (Scribe) y el guion
  transcriptCheck Float?
  characters      Int
  costMicroUsd    BigInt      @default(0)
  createdAt       DateTime    @default(now())

  @@index([itemSetId])
}

/// Forma completa de simulacro: bloques en orden por seccion y parte.
model ExamForm {
  id         String        @id @default(uuid(7))
  exam       ExamCode
  version    Int
  blocks     Json
  conversion Json?
  calibrated Boolean       @default(false)
  status     ItemSetStatus @default(APPROVED)
  createdAt  DateTime      @default(now())
  attempts   ExamAttempt[]

  @@unique([exam, version])
}

model ExamAttempt {
  id           String               @id @default(uuid(7))
  /// asignacion del docente que cumple este intento
  assignmentId String?
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         ExamCode
  mode         ExamMode
  formId       String?
  form         ExamForm?            @relation(fields: [formId], references: [id])
  status       ExamAttemptStatus    @default(IN_PROGRESS)
  /// que se practica (seccion, parte, tipo de pregunta...)
  config       Json
  scores       Json?
  overall      Float?
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  sections     ExamSectionAttempt[]
  responses    ExamResponse[]
  writing      WritingSubmission[]
  speaking     SpeakingSubmission[]
  report       ExamReport?

  @@unique([userId], map: "one_open_mock_per_user", where: raw("((mode = 'MOCK'::\"ExamMode\") AND (status = ANY (ARRAY['IN_PROGRESS'::\"ExamAttemptStatus\", 'SCORING'::\"ExamAttemptStatus\"])))"))
  @@index([userId, exam, startedAt(sort: Desc)])
}

model ExamSectionAttempt {
  id          String      @id @default(uuid(7))
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section     ExamSection
  part        Int         @default(0)
  itemSetIds  String[]
  startedAt   DateTime    @default(now())
  deadlineAt  DateTime?
  submittedAt DateTime?
  correct     Int?
  total       Int?
  score       Float?
  audioPlays  Json        @default("{}")
  tabSwitches Int         @default(0)

  @@unique([attemptId, section, part])
}

model ExamResponse {
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  itemSetId  String
  questionId String
  answer     Json
  isCorrect  Boolean?
  timeMs     Int?
  answeredAt DateTime    @default(now())

  @@id([attemptId, itemSetId, questionId])
}

model WritingSubmission {
  id           String      @id @default(uuid(7))
  attemptId    String
  attempt      ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskNumber   Int
  itemSetId    String
  text         String
  words        Int
  /// calificaciones independientes de la IA, por criterio
  grades       Json        @default("[]")
  finalScore   Float?
  feedback     Json?
  status       String      @default("PENDING")
  costMicroUsd BigInt      @default(0)
  createdAt    DateTime    @default(now())
  gradedAt     DateTime?

  @@unique([attemptId, taskNumber])
}

model SpeakingSubmission {
  id           String      @id @default(uuid(7))
  attemptId    String
  attempt      ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  part         Int
  itemSetId    String?
  /// turnos: pregunta del examinador, audio del estudiante (clave S3), transcripcion
  turns        Json        @default("[]")
  transcript   String      @default("")
  metrics      Json?
  grades       Json        @default("[]")
  finalScore   Float?
  feedback     Json?
  status       String      @default("IN_PROGRESS")
  costMicroUsd BigInt      @default(0)
  createdAt    DateTime    @default(now())
  gradedAt     DateTime?

  @@unique([attemptId, part])
}

model ExamReport {
  attemptId    String      @id
  attempt      ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  strengths    Json
  weaknesses   Json
  timing       Json
  narrative    String
  improvements Json
  createdAt    DateTime    @default(now())
}

model StudyPlan {
  id           String          @id @default(uuid(7))
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         ExamCode
  targets      Json
  examDate     DateTime?
  hoursPerWeek Int
  days         Int[]
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        StudyPlanItem[]

  @@unique([userId, exam], map: "one_active_plan_per_exam", where: raw("(status = 'ACTIVE'::text)"))
}

model StudyPlanItem {
  id              String       @id @default(uuid(7))
  planId          String
  plan            StudyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  dueDate         DateTime
  kind            String
  section         ExamSection?
  taskType        String?
  /// parte o tarea (Listening/Reading/Writing/Speaking), para ir directo a practicar
  part            Int?
  minutes         Int
  title           String
  status          String       @default("TODO")
  origin          String       @default("INITIAL")
  sourceAttemptId String?
  createdAt       DateTime     @default(now())

  @@index([planId, weekStart])
}

/// Dominio estimado por tipo de pregunta o criterio (0..1) con su error.
model SkillMastery {
  userId    String
  exam      ExamCode
  key       String
  value     Float
  se        Float
  n         Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, exam, key])
}

model ItemExposure {
  userId    String
  itemSetId String
  itemSet   ExamItemSet @relation(fields: [itemSetId], references: [id], onDelete: Cascade)
  mode      ExamMode
  seenAt    DateTime    @default(now())

  @@id([userId, itemSetId, mode])
  @@index([userId, mode])
}

/// Cupos por periodo (simulacros, correcciones de Writing, partes de Speaking).
model ExamEntitlement {
  id          String        @id @default(uuid(7))
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ExamQuotaKind
  periodStart DateTime
  periodEnd   DateTime
  granted     Int
  used        Int           @default(0)
  reserved    Int           @default(0)
  /// "plan:<pagoId>:MOCK" | "admin:<auditId>" ...
  sourceKey   String        @unique
  createdAt   DateTime      @default(now())

  @@index([userId, kind, periodEnd])
}

/// Solo insercion.
model ExamUsageEvent {
  id             BigInt        @id @default(autoincrement())
  entitlementId  String
  userId         String
  kind           ExamQuotaKind
  type           String
  amount         Int
  attemptId      String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

/// Cada llamada a un proveedor de IA o voz (alimenta el panel de costos). Solo insercion.
model AiUsage {
  id           BigInt   @id @default(autoincrement())
  provider     String
  model        String
  purpose      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  characters   Int      @default(0)
  seconds      Float    @default(0)
  costMicroUsd BigInt   @default(0)
  userId       String?
  refId        String?
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([purpose, createdAt])
}

/// Cola de trabajos largos de IA (FOR UPDATE SKIP LOCKED).
model ExamJob {
  id        String        @id @default(uuid(7))
  type      String
  payload   Json
  status    ExamJobStatus @default(QUEUED)
  attempts  Int           @default(0)
  runAfter  DateTime      @default(now())
  lockedAt  DateTime?
  error     String?
  result    Json?
  dedupeKey String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, runAfter])
}

/// Nota oficial reportada por el usuario tras el examen real.
model OfficialResult {
  id        String   @id @default(uuid(7))
  userId    String
  exam      ExamCode
  scores    Json
  takenAt   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────── Instituciones ─────────────────────────

enum OrgType {
  COMPANY
  SCHOOL
  UNIVERSITY
}

enum OrgRole {
  ORG_ADMIN
  TEACHER
  STUDENT
}

/// Institucion: empresa, colegio o universidad.
model Organization {
  id                      String       @id @default(uuid(7))
  /// identificador corto para enlaces
  slug                    String       @unique
  name                    String
  type                    OrgType
  taxId                   String?
  country                 String       @default("CO")
  enabledExams            ExamCode[]
  /// umbrales del semaforo: { riskBandGap, inactiveDays }
  thresholds              Json         @default("{\"riskBandGap\": 0.5, \"inactiveDays\": 7}")
  allowsMinors            Boolean      @default(false)
  /// fecha en que la institucion declaro tener las autorizaciones de los representantes
  minorsDeclarationAt     DateTime?
  avatarForMinors         Boolean      @default(false)
  cameraAllowed           Boolean      @default(true)
  recordingsRetentionDays Int          @default(180)
  createdAt               DateTime     @default(now())
  members                 OrgMember[]
  licenses                OrgLicense[]
  groups                  Group[]
  invitations             Invitation[]
}

/// Persona en una institucion (el rol global User.role no cambia).
model OrgMember {
  id        String         @id @default(uuid(7))
  orgId     String
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgRole
  /// ACTIVE | REMOVED
  status    String         @default("ACTIVE")
  birthDate DateTime?
  isMinor   Boolean        @default(false)
  /// licencia que ocupa (solo estudiantes activos)
  licenseId String?
  createdAt DateTime       @default(now())
  removedAt DateTime?
  teaching  GroupTeacher[]
  studying  GroupStudent[]

  @@unique([orgId, userId])
  @@index([userId])
}

/// Licencias compradas por periodo (Estandar o Intensiva).
model OrgLicense {
  id            String       @id @default(uuid(7))
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// estandar | intensiva
  kind          String
  seats         Int
  used          Int          @default(0)
  priceUsdCents Int
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime     @default(now())

  @@index([orgId, periodEnd])
}

model Group {
  id          String         @id @default(uuid(7))
  orgId       String
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  exam        ExamCode
  targetDate  DateTime?
  /// banda o puntos objetivo del grupo
  targetScore Float?
  createdAt   DateTime       @default(now())
  teachers    GroupTeacher[]
  students    GroupStudent[]
  assignments Assignment[]

  @@index([orgId])
}

model GroupTeacher {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member   OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
}

model GroupStudent {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member   OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  addedAt  DateTime  @default(now())

  @@id([groupId, memberId])
}

/// Invitacion por correo, enlace o codigo de grupo.
model Invitation {
  id        String       @id @default(uuid(7))
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  groupId   String?
  code      String       @unique
  role      OrgRole
  email     String?
  name      String?
  birthDate DateTime?
  maxUses   Int          @default(1)
  uses      Int          @default(0)
  expiresAt DateTime
  createdBy String?
  createdAt DateTime     @default(now())

  @@index([orgId])
}

/// Tarea del docente para un grupo (practica, Writing, Speaking o simulacro).
model Assignment {
  id        String             @id @default(uuid(7))
  groupId   String
  group     Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy String
  /// PRACTICE | WRITING | SPEAKING | MOCK
  kind      String
  title     String
  config    Json
  opensAt   DateTime
  closesAt  DateTime
  /// simulacro institucional: forma reservada para todo el grupo
  formId    String?
  createdAt DateTime           @default(now())
  results   AssignmentResult[]

  @@index([groupId, closesAt])
}

model AssignmentResult {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  memberId     String
  /// PENDING | DONE
  status       String     @default("PENDING")
  attemptId    String?
  completedAt  DateTime?

  @@id([assignmentId, memberId])
}

/// Nota y comentario del docente sobre un Writing o Speaking (solo insercion; la mas reciente vale).
model TeacherReview {
  id               BigInt   @id @default(autoincrement())
  /// WRITING | SPEAKING
  kind             String
  submissionId     String
  reviewerMemberId String
  aiScore          Float?
  score            Float
  reason           String
  comment          String?
  createdAt        DateTime @default(now())

  @@index([submissionId, createdAt])
}

model GroupStatsSnapshot {
  groupId String
  day     DateTime @db.Date
  data    Json

  @@id([groupId, day])
}

/// Regla de acceso por ambito (global, institucion, grupo o usuario).
model AccessRule {
  id        String    @id @default(uuid(7))
  /// GLOBAL | ORG | GROUP | USER
  scope     String
  scopeId   String    @default("")
  resource  String
  allowed   Boolean
  limits    Json?
  reason    String
  authorId  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([scope, scopeId, resource])
}

/// Alertas: clases o textos de menores, preguntas reportadas.
model ModerationFlag {
  id         String    @id @default(uuid(7))
  orgId      String?
  userId     String?
  refId      String?
  kind       String
  /// LOW | MEDIUM | HIGH
  severity   String    @default("MEDIUM")
  /// OPEN | RESOLVED
  status     String    @default("OPEN")
  note       String
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

/// Solicitudes de demo desde la pagina de instituciones.
model InstitutionLead {
  id          String   @id @default(uuid(7))
  institution String
  type        OrgType
  contactName String
  email       String
  phone       String?
  students    Int
  exams       String[]
  message     String?
  /// NEW | CONTACTED | WON | LOST
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

/// Segundo factor de autenticacion (TOTP y codigos de respaldo) de Better Auth.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}
